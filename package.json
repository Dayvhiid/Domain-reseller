{
  "name": "domain-reseller-frontend",
  "version": "1.0.0",
  "description": "Domain Reseller Platform Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && mkdir -p dist/legal && cp *.html dist/ && cp -r css js dist/ && cp -r legal/*.html dist/legal/",
    "preview": "vite preview",
    "build:css": "chmod +x ./node_modules/.bin/tailwindcss && npx tailwindcss -i ./css/input.css -o ./css/output.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.0"
  }
}
